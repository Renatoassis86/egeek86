# Copie este arquivo para .env.local e preencha com seus valores
# Pegue tudo em: Supabase Dashboard → seu projeto

# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ============================================================
# DATABASE (Postgres do Supabase, para Drizzle)
# ============================================================
# Transaction pooler (porta 6543) — runtime
DATABASE_URL=
# Direct/Session connection (porta 5432) — migrations
DIRECT_URL=

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================================
# GEEK DEALS — Coletor automático de preços
# ============================================================
# Segredo aleatório que protege /api/cron/collect-prices — gere com:
# openssl rand -hex 32 (ou qualquer gerador de string aleatória)
CRON_SECRET=

# Cadastro gratuito em developers.mercadolivre.com.br → Minhas aplicações
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_ACCESS_TOKEN=
MERCADO_LIVRE_REFRESH_TOKEN=

# Amazon PA-API 5.0 (Product Advertising API) — exige conta de Associados
# aprovada com vendas qualificadas nos últimos 30 dias. Estrutura pronta,
# aguardando credenciais (ver src/server/collector/sources/amazon.ts).
AMAZON_PA_API_ACCESS_KEY=
AMAZON_PA_API_SECRET_KEY=
AMAZON_PA_API_PARTNER_TAG=

# Shopee Affiliate API (affiliateshopee.com.br) — App ID/Secret aprovados
# pela Shopee. Estrutura pronta, aguardando credenciais (ver
# src/server/collector/sources/shopee.ts).
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_APP_SECRET=

# AliExpress Affiliate API (portals.aliexpress.com/affiportals) — App
# Key/Secret do Portal de Afiliados. Estrutura pronta, aguardando
# credenciais (ver src/server/collector/sources/aliexpress.ts).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# ============================================================
# GEEK DEALS — Notificações (alerta diário de queda de preço)
# ============================================================
# Bot criado via @BotFather no Telegram — ver docs/pg-cron-setup.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Segredo aleatório pro webhook validar que a chamada é do Telegram mesmo
# (header X-Telegram-Bot-Api-Secret-Token) — gere com: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Observabilidade do coletor (PROPOSTA, desligadas por padrão; exigem a migration 0025 aplicada).
# COLLECTOR_RUNS=1 liga o registro de execução (collector_runs) e last_price_confirmed_at.
# COLLECTOR_ALERTS=1 + TELEGRAM_ALERT_CHAT_ID (chat do dono/grupo de operação) liga o ENVIO de alertas; sem isso é dry-run.
COLLECTOR_RUNS=
COLLECTOR_ALERTS=
TELEGRAM_ALERT_CHAT_ID=

# Conta em resend.com — precisa verificar domínio de envio antes de mandar
# pra e-mails arbitrários (sandbox só manda pro próprio e-mail da conta).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ============================================================
# GEEK DEALS — Carrinho (lista de interesse) + aviso de admin
# ============================================================
# E-mail que recebe o aviso quando um comprador adiciona item ao carrinho.
ADMIN_NOTIFICATION_EMAIL=

# Meta WhatsApp Cloud API — envio automático da mensagem com os links do
# carrinho. Exige WhatsApp Business Account (WABA) com número comercial
# verificado + pelo menos 1 template de mensagem aprovado pela Meta (mensagem
# é business-initiated, não pode ser texto livre). Sem essas 3 variáveis, o
# admin ainda consegue enviar manualmente via link wa.me pré-preenchido — a
# funcionalidade não trava esperando a Meta aprovar nada.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# ============================================================
# PREÇO V2 e CARTÃO-PAI "O que sabemos hoje" (flags, desligadas por padrão)
# ============================================================
# PRICE_METRICS_V2=1 liga a leitura V2 do topo da página de produto (precisa das tabelas sombra, PRICE_DAILY_SHADOW=1).
# PRODUCT_CARD_V1=1 troca o bloco do topo pelo cartão-pai (Fase 1); só tem efeito junto de PRICE_METRICS_V2=1.
# Para desligar qualquer uma: deixar vazio/remover. Sem deploy sem autorização do dono.
PRICE_METRICS_V2=
PRODUCT_CARD_V1=
